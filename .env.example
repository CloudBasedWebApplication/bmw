# Application
APP_ENV=development
# Optional GitHub Codespaces hostname prefix used for browser-visible URLs.
CODESPACE_NAME=

# Docker Compose reads this file as the variable source, but each service
# declares only the variables it needs in docker-compose.yml.

# Database
MYSQL_HOST=mysql
MYSQL_PORT=3306
# Schema names are fixed and service-owned:
# - merch-shop uses bmw_merch_shop
# - car-configurator uses bmw_car_configurator
# - route-service uses bmw_route_service
MYSQL_USER=bmw_user
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

# Cache
REDIS_HOST=redis
REDIS_PORT=6379

# Object Storage
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ROOT_USER=minio_user
MINIO_ROOT_PASSWORD=change_me
MINIO_BUCKET=configurator-images

# External APIs
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GOOGLE_MAPS_API_KEY=replace_me
