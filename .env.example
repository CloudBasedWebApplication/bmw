# Application
APP_ENV=development

# Database
MYSQL_HOST=mysql
MYSQL_PORT=3306
# Schema names are fixed and service-owned:
# - merch-shop uses bmw_merch_shop
# - car-configurator uses bmw_car_configurator
MYSQL_USER=bmw_user
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

# Cache
REDIS_HOST=redis
REDIS_PORT=6379

# Object Storage
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ROOT_USER=minio_user
MINIO_ROOT_PASSWORD=change_me
MINIO_BUCKET=configurator-images
# Public browser URL for MinIO object links.
# Phase 1 default: same-origin app proxy through web-shop-frontend -> web-shop-backend /minio.
# Phase 2 target: keep port 9000 Docker-internal and use 9001 only for local console/debug access.
MINIO_PUBLIC_URL=/minio

# External APIs
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GOOGLE_MAPS_API_KEY=replace_me
