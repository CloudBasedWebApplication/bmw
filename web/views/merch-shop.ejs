<style>
  /* Merch-shop-specific layout. BMW CI tokens, fonts, page-shell, site-nav,
     site-footer, section-*, .btn*, .field/.input, .card* live in
     /static/ci/bmw-ci.css. */

  .merch-shop-layout {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 20px 80px;
  }

  .shop-header { margin-bottom: 48px; }
  .shop-header h1 {
    font-size: 2.8rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0 0 8px;
  }
  .shop-header p { color: var(--muted); font-size: 1.1rem; }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 32px;
    /* Override: merch-shop prefers square product images. */
    --card-image-aspect: 1 / 1;
  }

  .product-grid .card-image {
    transition: transform 0.6s ease;
  }
  .product-grid .card:hover .card-image {
    transform: scale(1.08);
  }

  .category-tag {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    margin-bottom: 8px;
  }

  .product-grid .card-body h2 {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0 0 12px;
    color: var(--ink);
  }

  .product-title-link {
    color: inherit;
    text-decoration: none;
  }

  .product-title-link:hover {
    color: var(--accent);
  }

  .price {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--ink);
    margin-bottom: 16px;
  }

  .variant-row {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-bottom: 18px;
  }

  .variant-label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--muted);
  }

  .variant-select {
    flex: 1;
    border: 1px solid rgba(15, 23, 42, 0.10);
    border-radius: 12px;
    background: #fff;
    padding: 12px 14px;
    font-size: 0.95rem;
    color: var(--ink);
  }

  .detail {
    font-size: 0.9rem;
    color: var(--muted);
    margin-bottom: 20px;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .shop-header h1 { font-size: 2.2rem; }
    .product-grid { gap: 20px; }
  }
</style>

<div class="merch-shop-layout">
  <%
    const groupedProducts = [];
    const groupMap = new Map();

    products.forEach((product) => {
      const groupKey = product.id;
      const existingGroup = groupMap.get(groupKey);

      if (existingGroup) {
        existingGroup.variants.push(product);
        return;
      }

      const group = {
        ...product,
        displayName: product.name,
        variants: [product],
      };

      groupedProducts.push(group);
      groupMap.set(groupKey, group);
    });
  %>
  <header class="shop-header">
    <h1>Lifestyle &amp; Merch</h1>
    <p>Bringen Sie die Freude am Fahren in Ihren Alltag.</p>
  </header>

  <div class="product-grid">
    <% groupedProducts.forEach(function(group) { const primaryProduct = group.variants[0]; const hasVariants = group.variants.length > 1; %>
      <article class="card card--product" id="product-<%= primaryProduct.id %>" data-detail-url="/merch-shop/<%= primaryProduct.slug || primaryProduct.id %>">
        <img
          class="card-image product-image"
          src="<%= primaryProduct.imageUrl %>"
          alt="<%= group.displayName %>"
          loading="lazy"
        />
        <div class="card-body">
          <div class="category-tag"><%= primaryProduct.category %><% if (primaryProduct.color) { %> / <%= primaryProduct.color %><% } %></div>
          <h2><a class="product-title-link" href="/merch-shop/<%= primaryProduct.slug || primaryProduct.id %>"><%= group.displayName %></a></h2>
          <div class="price"><%= parseFloat(primaryProduct.price).toLocaleString("de-DE", { style: "currency", currency: "EUR" }) %></div>

          <% if (primaryProduct.description) { %>
            <p class="detail"><%= primaryProduct.description %></p>
          <% } %>

          <% if (hasVariants) { %>
            <div class="variant-row">
              <label class="variant-label" for="variant-<%= primaryProduct.id %>">Farbe</label>
              <select class="variant-select" id="variant-<%= primaryProduct.id %>">
                <% group.variants.forEach(function(variant) { %>
                  <option
                    value="<%= variant.id %>"
                    data-name="<%= variant.name %>"
                    data-slug="<%= variant.slug || variant.id %>"
                    data-price="<%= variant.price %>"
                    data-image="<%= variant.imageUrl %>"
                    data-color="<%= variant.color %>">
                    <%= variant.color %>
                  </option>
                <% }) %>
              </select>
            </div>
          <% } %>

          <a class="btn btn-ghost" style="margin-top:12px; width:100%; justify-content:center;" href="/merch-shop/<%= primaryProduct.slug || primaryProduct.id %>">Details ansehen</a>
        </div>
      </article>
    <% }) %>
  </div>
</div>

<script>
  document.querySelectorAll(".card").forEach(card => {
    card.addEventListener("click", (event) => {
      if (event.target.closest("a, button, input, select, label")) return;
      if (card.dataset.detailUrl) {
        window.location.href = card.dataset.detailUrl;
      }
    });

    const variantSelect = card.querySelector(".variant-select");
    if (!variantSelect) return;

    const productImage = card.querySelector(".product-image");
    const detailLinks = card.querySelectorAll(".product-title-link, .btn-ghost");

    variantSelect.addEventListener("change", () => {
      const selectedOption = variantSelect.options[variantSelect.selectedIndex];
      productImage.src = selectedOption.dataset.image;
      productImage.alt = `${selectedOption.dataset.name} in ${selectedOption.dataset.color}`;
      detailLinks.forEach((link) => {
        link.href = `/merch-shop/${selectedOption.dataset.slug || selectedOption.value}`;
      });
      card.dataset.detailUrl = `/merch-shop/${selectedOption.dataset.slug || selectedOption.value}`;
    });
  });
</script>
