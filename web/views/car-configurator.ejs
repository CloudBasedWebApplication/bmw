  }

  .panel-step-actions--single {
    grid-template-columns: 1fr;
  }

  .config-order-summary {
    padding: 0 26px;
    margin-bottom: 6px;
  }

  .config-order-line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 14px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .config-order-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.42);
  }

  .config-order-price {
    font-size: 1.18rem;
    font-weight: 200;
    color: #fff;
    letter-spacing: 0.02em;
  }

  /* Panel at 1/3 height: 1 flex-part above, 2 flex-parts below */
  .config-column {
    position: sticky;
    top: calc(var(--config-nav-top) + var(--config-nav-height) + 16px);
    height: calc(100vh - var(--config-nav-top) - var(--config-nav-height) - var(--summary-bar-height) - 32px);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 0;
  }

  .config-column::before {
    content: "";
    flex: 1 0 0;
