    background: transparent;
    color: rgba(255, 255, 255, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.22);
    font-size: 0.63rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    transition: background 0.16s ease, border-color 0.16s ease, color 0.16s ease;
  }

  .config-buy-btn--primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .config-buy-btn--primary:hover:not(:disabled) {
    background: var(--accent-dark);
    border-color: var(--accent-dark);
    color: #fff;
    transform: none;
  }

  .config-buy-btn:not(.config-buy-btn--primary):hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.36);
    color: #fff;
    transform: none;
  }

  .config-buy-btn:disabled {
    opacity: 0.24;
    cursor: not-allowed;
  }

  .config-final-actions .completion-status {
    grid-column: 1 / -1;
    color: rgba(143, 192, 255, 0.9);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-align: center;
