<style>
  /* Configurator-specific layout. BMW CI tokens, fonts, page-shell, site-nav,
     site-footer, section-*, .btn*, .field/.input, .card* live in
     /static/ci/bmw-ci.css. The page-local --shadow override below intentionally
     replaces CI's default shadow on this view. */

  :root {
    --radius-lg: 2px;
    --radius-md: 2px;
    --shadow: 0 24px 80px rgba(15, 23, 42, 0.12);
    --config-rail: rgba(255, 255, 255, 0.92);
    --config-nav-top: 24px;
    --config-nav-height: 64px;
    --config-summary-top: calc(var(--config-nav-top) + var(--config-nav-height) + 16px);
    --summary-bar-height: 96px;
    --summary-panel-bg: rgba(255, 255, 255, 0.28);
    --summary-panel-border: rgba(17, 24, 39, 0.12);
    --summary-panel-text: #111827;
    --summary-panel-muted: #4b5563;
    --summary-panel-divider: rgba(17, 24, 39, 0.12);
    --summary-panel-text-shadow: 0 1px 12px rgba(255, 255, 255, 0.42);
  }

  body {
    background: #f4f4f4;
  }

  .site-nav--solid {
    position: fixed;
    top: var(--config-nav-top);
    left: 50%;
    z-index: 10;
    width: min(1180px, calc(100% - 40px));
    min-height: var(--config-nav-height);
    margin: 0;
    transform: translateX(-50%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius);
    background: var(--dark);
    color: #fff;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    transition: transform 0.24s ease;
  }

  .config-background {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background:
      linear-gradient(180deg, #f7f7f7 0%, #eeeeee 54%, #e5e5e5 54%, #f5f5f5 100%);
  }

  .config-background::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 0%, transparent 58%, rgba(244, 244, 244, 0.24) 100%);
    pointer-events: none;
  }

  .config-background img {
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
    filter: saturate(1.12) contrast(1.04);
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .config-layout {
    position: relative;
    z-index: 1;
    width: min(1180px, calc(100% - 40px));
    max-width: none;
    margin: 0 auto;
    min-height: calc(100vh - var(--config-summary-top));
    padding: calc(var(--config-summary-top) + var(--summary-bar-height) + 36px) 0 40px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(390px, 448px);
    gap: 40px;
    align-items: start;
  }

  @media (max-width: 980px) {
    .config-layout { grid-template-columns: 1fr; }
    .config-layout {
      width: min(1180px, calc(100% - 32px));
      padding: calc(var(--config-summary-top) + var(--summary-bar-height) + 36px) 0 28px;
    }
    .config-spacer { min-height: 40vh; }
    .config-column,
    .config-spacer { grid-column: 1; }
    .config-panel-stack {
      max-height: calc(100vh - var(--config-summary-top) - var(--summary-bar-height) - 40px);
      margin-top: 0;
      transform: none;
    }
    .config-background img {
      object-position: center center;
    }
  }

  .placeholder {
    position: fixed;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    color: #6b7280;
    font-weight: 600;
    text-align: center;
  }

  .config-column {
    display: flex;
    flex-direction: column;
    gap: 20px;
    grid-column: 2;
  }

  .config-panel-stack {
    position: relative;
    height: var(--config-panel-stack-height, auto);
    max-height: calc(100vh - var(--config-summary-top) - var(--summary-bar-height) - 72px);
    min-height: 295px;
    margin-top: 189px;
    overflow: hidden;
    transition: height 0.42s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .panel {
    background: var(--config-rail);
    border-radius: var(--radius-lg);
    padding: 26px 28px;
    box-shadow: var(--shadow);
    border: 1px solid rgba(17, 24, 39, 0.08);
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);
  }

  .config-options-panel {
    background: rgba(255, 255, 255, 0.28);
    border-color: rgba(255, 255, 255, 0.26);
    box-shadow: 0 18px 60px rgba(15, 23, 42, 0.08);
    box-sizing: border-box;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    min-height: 295px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transform: translateY(100%);
    transition: transform 0.68s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.5s ease;
  }

  .config-options-panel.active {
    border-color: rgba(17, 24, 39, 0.22);
    position: relative;
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
    transform: translateY(0);
  }

  .config-options-panel.is-transitioning {
    position: absolute;
    top: 0;
    left: 0;
    visibility: visible;
    pointer-events: none;
  }

  .config-options-panel.enter-from-bottom {
    transform: translateY(100%);
  }

  .config-options-panel.enter-from-top {
    transform: translateY(-100%);
  }

  .config-options-panel.exit-to-top {
    opacity: 0;
    transform: translateY(-72%);
  }

  .config-options-panel.exit-to-bottom {
    opacity: 0;
    transform: translateY(72%);
  }

  .config-spacer {
    min-height: 1px;
    grid-column: 1;
    padding-top: 10px;
  }

  .config-layout h1 {
    font-size: 1.9rem;
    font-weight: 700;
    letter-spacing: 0;
    margin: 0 0 8px;
  }

  .section-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #4b5563;
    margin: 26px 0 12px;
  }

  .config-btn-group,
  .option-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .config-btn-group {
    display: grid;
    grid-template-columns: 1fr;
  }

  .config-btn,
  .option-btn {
    width: 100%;
    min-height: 54px;
    padding: 15px 18px;
    border: 1px solid rgba(17, 24, 39, 0.14);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.84);
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    font-family: inherit;
    color: var(--ink);
    text-align: center;
  }

  .config-btn:hover,
  .option-btn:hover {
    border-color: #111827;
    background: #fff;
    box-shadow: 0 12px 26px rgba(15, 23, 42, 0.08);
    transform: translateY(-1px);
  }

  .config-btn.active,
  .option-btn.active {
    background: #111827;
    color: #fff;
    border-color: #111827;
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.12), 0 14px 32px rgba(15, 23, 42, 0.18);
  }

  .color-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .swatch-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    box-sizing: border-box;
    min-height: 54px;
    padding: 10px 14px 10px 10px;
    border: 1px solid rgba(17, 24, 39, 0.14);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    background: rgba(255, 255, 255, 0.84);
  }

  .swatch-wrapper:hover {
    border-color: #111827;
    background: #fff;
    box-shadow: 0 12px 26px rgba(15, 23, 42, 0.08);
    transform: translateY(-1px);
  }

  .swatch-wrapper.active {
    border-color: #111827;
    background: rgba(17, 24, 39, 0.94);
    color: #fff;
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.12), 0 14px 32px rgba(15, 23, 42, 0.18);
  }

  .swatch {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.12);
    display: inline-block;
    flex-shrink: 0;
  }

  .swatch-label {
    font-size: 0.92rem;
    font-weight: 600;
  }

  .summary-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 0.9fr) minmax(0, 1fr) minmax(0, 1.45fr);
    gap: 10px;
    min-width: 0;
  }

  .summary-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 7px;
    min-height: 66px;
    padding: 12px 14px;
    border: 1px solid transparent;
    appearance: none;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
    min-width: 0;
    text-align: left;
    transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .summary-row:hover {
    background: rgba(255, 255, 255, 0.24);
    border-color: rgba(17, 24, 39, 0.12);
  }

  .summary-row.active {
    background: rgba(17, 24, 39, 0.08);
    color: var(--summary-panel-text);
    border-color: rgba(17, 24, 39, 0.16);
    border-radius: var(--radius-md);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.42), 0 10px 24px rgba(15, 23, 42, 0.08);
  }

  .summary-key {
    color: inherit;
    opacity: 0.72;
    font-size: 0.86rem;
    font-weight: 800;
    text-shadow: var(--summary-panel-text-shadow);
    white-space: nowrap;
  }

  .summary-value {
    color: var(--summary-panel-text);
    font-size: clamp(0.68rem, 0.76vw, 0.84rem);
    font-weight: 900;
    max-width: 100%;
    text-align: left;
    text-shadow: var(--summary-panel-text-shadow);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .summary-badge {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    min-height: 28px;
    padding: 5px 10px;
    border-radius: 999px;
    background: rgba(17, 24, 39, 0.1);
    border: 1px solid rgba(17, 24, 39, 0.12);
    line-height: 1.1;
  }

  .summary-badge.is-placeholder {
    color: var(--summary-panel-muted);
    background: rgba(255, 255, 255, 0.18);
    border-style: dashed;
    font-weight: 800;
  }

  .summary-row.active .summary-badge {
    background: rgba(17, 24, 39, 0.1);
    border-color: rgba(17, 24, 39, 0.16);
  }

  .summary-row.active .summary-badge.is-placeholder {
    color: var(--summary-panel-muted);
  }

  .summary-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 14px;
    min-width: 260px;
    padding-left: 20px;
    border-left: 1px solid var(--summary-panel-divider);
  }

  .price-tag {
    display: flex;
    flex-direction: column;
    min-width: 104px;
    text-align: right;
    gap: 4px;
  }

  .price-tag span {
    font-size: 0.86rem;
    color: var(--summary-panel-muted);
    font-weight: 800;
    letter-spacing: 0;
    text-transform: none;
    text-shadow: var(--summary-panel-text-shadow);
  }

  .price-main {
    color: var(--summary-panel-text);
    font-size: clamp(0.86rem, 1vw, 1.02rem);
    font-weight: 800;
    line-height: 1.35;
    text-shadow: var(--summary-panel-text-shadow);
    white-space: nowrap;
  }

  .add-btn {
    width: 100%;
    min-height: 54px;
    padding: 0 18px;
    border-radius: var(--radius-md);
    border: none;
    background: #2d74d8;
    color: #fff;
    font-size: 0.98rem;
    font-weight: 700;
    cursor: pointer;
    transition: 0.2s;
    margin-top: 18px;
    font-family: inherit;
  }

  .summary-panel {
    position: fixed;
    top: var(--config-summary-top);
    left: 50%;
    z-index: 9;
    width: min(1180px, calc(100% - 40px));
    min-height: var(--summary-bar-height);
    margin: 0;
    padding: 14px 32px;
    background: var(--summary-panel-bg);
    color: var(--summary-panel-text);
    transform: translateX(-50%);
    border-width: 1px;
    border-color: var(--summary-panel-border);
    border-radius: var(--radius);
    box-shadow: 0 18px 60px rgba(15, 23, 42, 0.08);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, auto);
    gap: 20px;
    align-items: center;
    transition: top 0.24s ease, background 0.25s ease, border-color 0.25s ease, color 0.25s ease;
  }

  .summary-panel[data-contrast="dark"] {
    --summary-panel-bg: rgba(11, 18, 32, 0.34);
    --summary-panel-border: rgba(255, 255, 255, 0.2);
    --summary-panel-text: #ffffff;
    --summary-panel-muted: rgba(255, 255, 255, 0.72);
    --summary-panel-divider: rgba(255, 255, 255, 0.18);
    --summary-panel-text-shadow: 0 1px 14px rgba(0, 0, 0, 0.72);
  }

  .summary-panel[data-contrast="light"] {
    --summary-panel-bg: rgba(255, 255, 255, 0.3);
    --summary-panel-border: rgba(17, 24, 39, 0.14);
    --summary-panel-text: #111827;
    --summary-panel-muted: #4b5563;
    --summary-panel-divider: rgba(17, 24, 39, 0.12);
    --summary-panel-text-shadow: 0 1px 12px rgba(255, 255, 255, 0.54);
  }

  .summary-panel .summary-grid {
    min-width: 0;
  }

  .completion-status {
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    min-height: 0;
    min-width: max-content;
    transform: translateX(-50%);
    color: #047857;
    font-weight: 400;
    text-align: center;
    font-size: 0.72rem;
    line-height: 1.2;
    max-width: 100%;
  }

  @media (max-width: 760px) {
    :root {
      --config-nav-height: 160px;
      --summary-bar-height: 286px;
    }

    .summary-panel {
      min-height: var(--summary-bar-height);
      padding: 12px 16px;
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .summary-actions {
      align-items: stretch;
      min-width: 0;
      padding-left: 0;
      padding-top: 10px;
      border-left: 0;
      border-top: 1px solid var(--summary-panel-divider);
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .price-tag {
      min-width: 0;
      text-align: left;
    }

    .completion-status {
      grid-column: 1 / -1;
      max-width: none;
      text-align: center;
    }

    .summary-grid {
      grid-template-columns: 1fr;
      gap: 6px;
    }

    .summary-row {
      min-height: 40px;
      padding: 8px 10px;
      border-right: 0;
      border-bottom: 0;
    }

    .summary-badge {
      min-height: 24px;
      padding: 4px 8px;
    }

  }

  .add-btn:hover:not(:disabled) {
    background: #245fb1;
    transform: translateY(-1px);
  }

  .add-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* BMW configurator visual refresh. The original interaction model stays intact,
     this layer reshapes the page into a clean vehicle stage plus focused side rail. */
  :root {
    --radius-lg: 2px;
    --radius-md: 2px;
    --shadow: 0 18px 48px rgba(17, 24, 39, 0.12);
    --config-nav-top: 18px;
    --config-nav-height: 68px;
    --config-summary-top: calc(var(--config-nav-top) + var(--config-nav-height) + 12px);
    --summary-bar-height: 112px;
    --config-side-width: 462px;
    --summary-panel-bg: rgba(255, 255, 255, 0.96);
    --summary-panel-border: rgba(17, 24, 39, 0.13);
    --summary-panel-text: #111827;
    --summary-panel-muted: #5d6675;
    --summary-panel-divider: rgba(17, 24, 39, 0.12);
    --summary-panel-text-shadow: none;
  }

  body {
    background: #f2f3f5;
    overflow-x: hidden;
  }

  main {
    min-height: 100vh;
  }

  .site-nav--solid {
    top: var(--config-nav-top);
    width: min(1280px, calc(100% - 48px));
    min-height: var(--config-nav-height);
    padding: 12px 16px 12px 24px;
    border: 1px solid rgba(17, 24, 39, 0.12);
    background: rgba(255, 255, 255, 0.97);
    color: var(--ink);
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.1);
  }

  .site-nav--solid .brand span {
    color: rgba(17, 24, 39, 0.54);
  }

  .site-nav--solid .nav-links a {
    color: rgba(17, 24, 39, 0.68);
  }

  .site-nav--solid .nav-links a:hover,
  .site-nav--solid .nav-links a.active {
    background: rgba(28, 105, 212, 0.08);
    color: var(--accent);
  }

  .config-background {
    background:
      linear-gradient(180deg, #ffffff 0%, #f6f7f9 48%, #e7e9ed 49%, #f5f6f8 100%);
  }

  .config-background::before {
    content: "";
    position: absolute;
    left: 0;
    right: var(--config-side-width);
    bottom: 29%;
    z-index: 0;
    height: 1px;
    background: rgba(17, 24, 39, 0.09);
  }

  .config-background::after {
    z-index: 2;
    background:
      linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0) 54%, rgba(242, 243, 245, 0.7) 74%, #f2f3f5 100%),
      linear-gradient(180deg, rgba(255, 255, 255, 0) 66%, rgba(242, 243, 245, 0.9) 100%);
  }

  .config-background img {
    position: absolute;
    inset: 0 auto 0 0;
    z-index: 1;
    width: calc(100% - var(--config-side-width));
    height: 100%;
    padding: 158px clamp(30px, 5vw, 82px) 122px;
    object-fit: contain;
    object-position: center 56%;
    filter: saturate(1.04) contrast(1.02);
  }

  .placeholder {
    inset: var(--config-summary-top) var(--config-side-width) 0 0;
    z-index: 3;
    padding: 24px;
    pointer-events: none;
  }

  .config-layout {
    z-index: 4;
    width: min(1280px, calc(100% - 48px));
    min-height: 100vh;
    padding: calc(var(--config-summary-top) + var(--summary-bar-height) + 26px) 0 58px;
    grid-template-columns: minmax(0, 1fr) minmax(388px, 430px);
    gap: clamp(30px, 5vw, 70px);
  }

  .config-spacer {
    grid-column: 1;
    min-height: calc(100vh - var(--config-summary-top) - var(--summary-bar-height) - 84px);
    padding: 0;
  }

  .config-column {
    grid-column: 2;
    gap: 14px;
  }

  .config-panel-stack {
    position: sticky;
    top: calc(var(--config-summary-top) + var(--summary-bar-height) + 26px);
    max-height: calc(100vh - var(--config-summary-top) - var(--summary-bar-height) - 52px);
    min-height: 365px;
    margin-top: 0;
  }

  .panel,
  .config-options-panel {
    border-radius: 2px;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .config-options-panel {
    min-height: 365px;
    justify-content: flex-start;
    padding: 30px;
    background: rgba(255, 255, 255, 0.98);
    border-color: rgba(17, 24, 39, 0.1);
    box-shadow: var(--shadow);
  }

  .config-options-panel.active {
    border-color: rgba(17, 24, 39, 0.15);
  }

  .panel-eyebrow {
    margin: 0 0 8px;
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .panel-copy {
    margin: 0 0 24px;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .config-layout h1 {
    margin: 0 0 8px;
    font-size: clamp(1.7rem, 2.4vw, 2.25rem);
    line-height: 1.05;
  }

  .config-btn-group,
  .option-group,
  .color-group {
    gap: 12px;
  }

  .config-btn,
  .option-btn,
  .swatch-wrapper {
    position: relative;
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 14px 18px;
    border-color: rgba(17, 24, 39, 0.14);
    border-radius: 2px;
    background: #fff;
    color: var(--ink);
    text-align: left;
    box-shadow: none;
  }

  .swatch-wrapper {
    appearance: none;
    border-style: solid;
    font: inherit;
  }

  .config-btn::after,
  .option-btn::after,
  .swatch-wrapper::after {
    content: "";
    width: 20px;
    height: 20px;
    flex: 0 0 auto;
    border: 2px solid rgba(17, 24, 39, 0.26);
    border-radius: 50%;
    background: #fff;
  }

  .config-btn:hover,
  .option-btn:hover,
  .swatch-wrapper:hover {
    border-color: rgba(28, 105, 212, 0.55);
    background: #f8fbff;
    box-shadow: 0 12px 24px rgba(17, 24, 39, 0.08);
  }

  .config-btn.active,
  .option-btn.active,
  .swatch-wrapper.active {
    border-color: var(--accent);
    background: #f3f8ff;
    color: var(--ink);
    box-shadow: inset 0 0 0 1px rgba(28, 105, 212, 0.18);
  }

  .config-btn.active::after,
  .option-btn.active::after,
  .swatch-wrapper.active::after {
    border: 6px solid var(--accent);
  }

  .config-option-copy {
    display: grid;
    gap: 5px;
    min-width: 0;
  }

  .config-option-title {
