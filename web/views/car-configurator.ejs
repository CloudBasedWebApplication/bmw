    font-size: 0.92rem;
    font-weight: 700;
    gap: 3px;
  }

  .panel-step-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .panel-step-btn {
    min-height: 42px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 0;
